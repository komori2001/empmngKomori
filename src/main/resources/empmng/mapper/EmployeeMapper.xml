<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="empmng.mapper.EmployeeMapper">



<select id="getEmployees" resultType="empmng.entity.Employee">

    SELECT * FROM employees ORDER BY no

</select>

<select id="removeEmployee" resultType="empmng.entity.Employee">

    DELETE * FROM employees WHERE no = #{no}

</select>


<select id="addEmployee" parameterType = "empmng.entity.Employee" >

    INSERT INTO employees (no, name, birthday) VALUES (#{no},#{name},#{birthday})

</select>






















</mapper>